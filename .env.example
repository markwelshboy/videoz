VIDEOZ_DATA_DIR=/data
VIDEOZ_FFMPEG_BIN=ffmpeg
VIDEOZ_FFPROBE_BIN=ffprobe
VIDEOZ_MAX_UPLOAD_GB=20

# Caption providers
# OpenRouter vision models (for example qwen/qwen3-vl-8b-instruct)
VIDEOZ_OPENROUTER_API_KEY=
VIDEOZ_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional local/OpenAI-compatible VLM endpoint. This keeps the caption UI
# independent from how Qwen3-VL is served (vLLM, another gateway, etc.).
VIDEOZ_VLM_BASE_URL=
VIDEOZ_VLM_API_KEY=
VIDEOZ_VLM_DEFAULT_MODEL=Qwen/Qwen3-VL-8B-Instruct
